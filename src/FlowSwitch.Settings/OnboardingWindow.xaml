<Window x:Class="FlowSwitch.Settings.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:FlowSwitch.Settings.Controls"
        xmlns:settings="clr-namespace:FlowSwitch.Core.Settings;assembly=FlowSwitch.Core"
        Title="Welcome to FlowSwitch"
        Width="920" Height="620" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource FallbackBackdropBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource TextFont}"
        UseLayoutRounding="True"
        Icon="pack://application:,,,/Assets/flowswitch-256.png">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="-1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Border x:Name="Tint" Background="#C70A0D14" />

        <!-- Screens: only one is visible at a time; see OnboardingWindow.xaml.cs for the transitions. -->
        <Grid x:Name="Screens" Margin="0,0,0,84">

            <!-- 1 · Welcome -->
            <Grid x:Name="WelcomeScreen">
                <Ellipse Width="560" Height="560" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-40,0,0" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="#2E7A84FF" />
                            <GradientStop Offset="0.5" Color="#0F56D6FF" />
                            <GradientStop Offset="1" Color="#0056D6FF" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <Image x:Name="WelcomeLogo" Source="pack://application:,,,/Assets/flowswitch-256.png" Width="148" Height="148"
                           RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <ScaleTransform x:Name="WelcomeLogoScale" ScaleX="1" ScaleY="1" />
                        </Image.RenderTransform>
                    </Image>
                    <TextBlock Text="Welcome to FlowSwitch" FontFamily="{StaticResource DisplayFont}" FontSize="38" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,30,0,0" />
                    <TextBlock Text="Your windows. In motion." FontSize="18" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,10,0,0" />
                </StackPanel>
            </Grid>

            <!-- 2 · Solar System -->
            <Grid x:Name="SolarScreen" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <c:OrbitPreview x:Name="SolarPreview" Settings="{Binding Settings}" Margin="48,48,48,0" CornerRadius="16" WindowCount="7"
                                ModeOverride="{x:Static settings:SwitcherMode.SolarSystem}" />
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,26,0,0">
                    <TextBlock Text="Solar System" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Navigate your workspace naturally." FontSize="16" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Border Style="{StaticResource KeyCapText}"><TextBlock Text="Tab" FontSize="12" FontWeight="SemiBold" /></Border>
                        <TextBlock Text="rotates" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,18,0" />
                        <Border Style="{StaticResource KeyCapText}"><TextBlock Text="Shift + Tab" FontSize="12" FontWeight="SemiBold" /></Border>
                        <TextBlock Text="goes back" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,18,0" />
                        <Border Style="{StaticResource KeyCapText}"><TextBlock Text="Release Alt" FontSize="12" FontWeight="SemiBold" /></Border>
                        <TextBlock Text="opens" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- 3 · Make it yours -->
            <Grid x:Name="CustomizeScreen" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>
                <c:OrbitPreview x:Name="CustomPreview" Settings="{Binding Settings}" Margin="48,48,24,0" CornerRadius="16" WindowCount="7" />
                <StackPanel Grid.Column="1" Margin="0,56,48,0">
                    <TextBlock Text="Layout" Style="{StaticResource CaptionText}" Margin="0,0,0,8" />
                    <UniformGrid Columns="2">
                        <RadioButton Style="{StaticResource SegmentButton}" Content="Solar System" Margin="0,0,4,4"
                                     IsChecked="{Binding Settings.General.Mode, Converter={StaticResource EnumBool}, ConverterParameter=SolarSystem}" />
                        <RadioButton Style="{StaticResource SegmentButton}" Content="Orbit Minimal" Margin="0,0,0,4"
                                     IsChecked="{Binding Settings.General.Mode, Converter={StaticResource EnumBool}, ConverterParameter=OrbitMinimal}" />
                        <RadioButton Style="{StaticResource SegmentButton}" Content="Carousel" Margin="0,0,4,4"
                                     IsChecked="{Binding Settings.General.Mode, Converter={StaticResource EnumBool}, ConverterParameter=Carousel}" />
                        <RadioButton Style="{StaticResource SegmentButton}" Content="Cover Flow" Margin="0,0,0,4"
                                     IsChecked="{Binding Settings.General.Mode, Converter={StaticResource EnumBool}, ConverterParameter=CoverFlow}" />
                        <RadioButton Style="{StaticResource SegmentButton}" Content="Grid" Margin="0,0,4,4"
                                     IsChecked="{Binding Settings.General.Mode, Converter={StaticResource EnumBool}, ConverterParameter=Grid}" />
                    </UniformGrid>

                    <TextBlock Text="Motion" Style="{StaticResource CaptionText}" Margin="0,18,0,8" />
                    <UniformGrid Columns="2">
                        <RadioButton Style="{StaticResource SegmentButton}" Content="Smooth" Margin="0,0,4,4"
                                     IsChecked="{Binding Settings.Animation.Preset, Converter={StaticResource EnumBool}, ConverterParameter=Smooth}" />
                        <RadioButton Style="{StaticResource SegmentButton}" Content="Snappy" Margin="0,0,0,4"
                                     IsChecked="{Binding Settings.Animation.Preset, Converter={StaticResource EnumBool}, ConverterParameter=Snappy}" />
                        <RadioButton Style="{StaticResource SegmentButton}" Content="Cinematic" Margin="0,0,4,4"
                                     IsChecked="{Binding Settings.Animation.Preset, Converter={StaticResource EnumBool}, ConverterParameter=Cinematic}" />
                        <RadioButton Style="{StaticResource SegmentButton}" Content="Minimal" Margin="0,0,0,4"
                                     IsChecked="{Binding Settings.Animation.Preset, Converter={StaticResource EnumBool}, ConverterParameter=Minimal}" />
                    </UniformGrid>

                    <TextBlock Text="Glow" Style="{StaticResource CaptionText}" Margin="0,18,0,0" />
                    <c:SettingSlider Width="Auto" Value="{Binding Settings.Appearance.GlowIntensity}" />
                    <TextBlock Text="Blur" Style="{StaticResource CaptionText}" Margin="0,8,0,0" />
                    <c:SettingSlider Width="Auto" Value="{Binding Settings.Appearance.BlurIntensity}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Center" Margin="0,26,0,0">
                    <TextBlock Text="Make it yours" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Customize motion, glow and layout." FontSize="16" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
            </Grid>

            <!-- 4 · Ready -->
            <Grid x:Name="ReadyScreen" Visibility="Collapsed">
                <Ellipse Width="520" Height="520" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="#267A84FF" />
                            <GradientStop Offset="1" Color="#007A84FF" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Ready" FontFamily="{StaticResource DisplayFont}" FontSize="44" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Press Alt + Tab." FontSize="18" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,34,0,0">
                        <Border x:Name="AltKey" CornerRadius="12" BorderThickness="1,1,1,3" BorderBrush="#40FFFFFF" Background="#18FFFFFF" Width="112" Height="64">
                            <Border.Effect>
                                <DropShadowEffect x:Name="AltGlow" BlurRadius="30" ShadowDepth="0" Opacity="0.2" Color="{StaticResource AccentColor}" />
                            </Border.Effect>
                            <TextBlock Text="Alt" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="+" FontSize="22" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="16,0" />
                        <Border x:Name="TabKey" CornerRadius="12" BorderThickness="1,1,1,3" BorderBrush="#40FFFFFF" Background="#18FFFFFF" Width="136" Height="64">
                            <Border.Effect>
                                <DropShadowEffect x:Name="TabGlow" BlurRadius="30" ShadowDepth="0" Opacity="0.2" Color="{StaticResource AccentAltColor}" />
                            </Border.Effect>
                            <TextBlock Text="Tab" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,40,0,0">
                        <TextBlock Text="Start with Windows" VerticalAlignment="Center" Margin="0,0,14,1" Foreground="{StaticResource TextSecondaryBrush}" />
                        <c:ToggleSwitch IsChecked="{Binding Settings.General.LaunchAtStartup}" OnText="" OffText="" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Close -->
        <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;" HorizontalAlignment="Right" VerticalAlignment="Top"
                WindowChrome.IsHitTestVisibleInChrome="True" Click="OnCloseClick" ToolTip="Close" />

        <!-- Footer: progress + navigation -->
        <Grid VerticalAlignment="Bottom" Height="84" Margin="48,0,48,0">
            <StackPanel x:Name="Dots" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="BackButton" Style="{StaticResource SubtleButton}" Content="Back" Click="OnBack" Margin="0,0,8,0" MinWidth="86" />
                <Button x:Name="SettingsButton" Content="Open Settings" Click="OnOpenSettings" Margin="0,0,8,0" Visibility="Collapsed" />
                <Button x:Name="NextButton" Style="{StaticResource AccentButton}" Content="Get started" Click="OnNext" MinWidth="120" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
