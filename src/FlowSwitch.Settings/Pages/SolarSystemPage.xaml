<UserControl x:Class="FlowSwitch.Settings.Pages.SolarSystemPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:FlowSwitch.Settings.Controls"
             xmlns:settings="clr-namespace:FlowSwitch.Core.Settings;assembly=FlowSwitch.Core">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitleText}" Text="Solar System" />
        <TextBlock Style="{StaticResource PageSubtitleText}"
                   Text="The selected window sits at the center; the others travel on orbits around it. Tab turns the whole system." />

        <Grid Margin="0,22,0,0">
            <c:OrbitPreview x:Name="Preview" Settings="{Binding Settings}" ModeOverride="{x:Static settings:SwitcherMode.SolarSystem}" Height="300" WindowCount="7" />
            <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0" Background="#990A0D14">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource SegmentButton}" Content="4 windows" Tag="4" Checked="OnPreviewCount" Padding="10,4" />
                    <RadioButton Style="{StaticResource SegmentButton}" Content="7" Tag="7" Checked="OnPreviewCount" Padding="10,4" IsChecked="True" />
                    <RadioButton Style="{StaticResource SegmentButton}" Content="12" Tag="12" Checked="OnPreviewCount" Padding="10,4" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Style="{StaticResource SectionHeaderText}" Text="Orbits" />
        <c:SettingCard Header="Shape" Icon="&#xE7AD;" Description="From round orbits to wide, flat ellipses.">
            <c:SettingSlider Value="{Binding Settings.Solar.OrbitShape}" />
        </c:SettingCard>
        <c:SettingCard Header="Number of orbits" Icon="&#xE81E;"
                       Description="Automatic: one orbit for up to 5 windows, two for up to 10, then three and four. A fixed number gains orbits only when needed to keep windows apart.">
            <c:SettingSlider Minimum="0" Maximum="4" Format="Number" MinimumLabel="Auto" TickFrequency="1" IsSnapToTickEnabled="True"
                             SmallChange="1" LargeChange="1" Value="{Binding Settings.Solar.OrbitCount}" />
        </c:SettingCard>
        <c:SettingCard Header="Spacing" Icon="&#xE740;" Description="Distance between orbits and from the center.">
            <c:SettingSlider Value="{Binding Settings.Solar.OrbitSpacing}" />
        </c:SettingCard>
        <c:SettingCard Header="Show orbit lines" Icon="&#xE7AD;">
            <c:ToggleSwitch IsChecked="{Binding Settings.Solar.OrbitLines}" />
        </c:SettingCard>

        <TextBlock Style="{StaticResource SectionHeaderText}" Text="Rotation" />
        <c:SettingCard Header="Rotation strength" Icon="&#xE8AB;" Description="How far the orbits swing while the system turns.">
            <c:SettingSlider Value="{Binding Settings.Solar.RotationIntensity}" />
        </c:SettingCard>
        <c:SettingCard Header="Direction" Icon="&#xE72C;" Description="Which way Tab turns the system.">
            <Border Style="{StaticResource SegmentHost}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource SegmentButton}" Content="Clockwise"
                                 IsChecked="{Binding Settings.Solar.Direction, Converter={StaticResource EnumBool}, ConverterParameter=Clockwise}" />
                    <RadioButton Style="{StaticResource SegmentButton}" Content="Counter-clockwise"
                                 IsChecked="{Binding Settings.Solar.Direction, Converter={StaticResource EnumBool}, ConverterParameter=CounterClockwise}" />
                </StackPanel>
            </Border>
        </c:SettingCard>
        <c:SettingCard Header="Idle drift" Icon="&#xE916;" Description="While you look, the orbits drift almost imperceptibly.">
            <c:ToggleSwitch x:Name="IdleToggle" IsChecked="{Binding Settings.Solar.IdleRotation}" />
        </c:SettingCard>
        <c:SettingCard Header="Drift speed" Icon="&#xE916;" IsEnabled="{Binding IsChecked, ElementName=IdleToggle}">
            <c:SettingSlider Value="{Binding Settings.Solar.IdleRotationSpeed}" />
        </c:SettingCard>

        <TextBlock Style="{StaticResource SectionHeaderText}" Text="Depth and light" />
        <c:SettingCard Header="Depth" Icon="&#xE81E;" Description="How much smaller, darker and softer the farther windows become.">
            <c:SettingSlider Value="{Binding Settings.Solar.CardDepth}" />
        </c:SettingCard>
        <c:SettingCard Header="Perspective" Icon="&#xE7C4;">
            <c:SettingSlider Value="{Binding Settings.Solar.Perspective}" />
        </c:SettingCard>
        <c:SettingCard Header="Glow" Icon="&#xE706;">
            <c:SettingSlider Value="{Binding Settings.Solar.Glow}" />
        </c:SettingCard>
        <c:SettingCard Header="Ambient light" Icon="&#xE790;" Description="The colored light cast by the selected window.">
            <c:SettingSlider Value="{Binding Settings.Solar.AmbientLight}" />
        </c:SettingCard>
        <c:SettingCard Header="Particles" Icon="&#xE734;">
            <c:ToggleSwitch IsChecked="{Binding Settings.Solar.Particles}" />
        </c:SettingCard>
        <c:SettingCard Header="Parallax" Icon="&#xE962;" Description="The system leans very slightly toward the mouse pointer.">
            <c:ToggleSwitch IsChecked="{Binding Settings.Solar.Parallax}" />
        </c:SettingCard>
    </StackPanel>
</UserControl>
