<UserControl x:Class="FlowSwitch.Settings.Pages.AdvancedPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:FlowSwitch.Settings.Controls"
             xmlns:s="clr-namespace:FlowSwitch.Settings.Services">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitleText}" Text="Advanced" />
        <TextBlock Style="{StaticResource PageSubtitleText}"
                   Text="FlowSwitch is built to fail safe: if it ever stops responding, Windows' own Alt + Tab takes over on its own." />

        <TextBlock Style="{StaticResource SectionHeaderText}" Text="Fail-safe" />
        <c:SettingCard Header="Response deadline" Icon="&#xE916;"
                       Description="If the switcher does not answer within this time, Windows' Alt + Tab opens instead.">
            <c:SettingSlider Minimum="80" Maximum="1000" Format="Milliseconds" TickFrequency="10" IsSnapToTickEnabled="True" SmallChange="10" LargeChange="50"
                             Value="{Binding Settings.Advanced.OverlayTimeoutMs}" />
        </c:SettingCard>
        <c:SettingCard Header="Windows Alt + Tab in fullscreen games" Icon="&#xE7FC;"
                       Description="Games running in exclusive fullscreen keep the native switcher.">
            <c:ToggleSwitch IsChecked="{Binding Settings.Advanced.NativeInFullscreenGames}" />
        </c:SettingCard>
        <c:SettingCard Header="Restart automatically after a problem" Icon="&#xE72C;"
                       Description="After repeated crashes FlowSwitch pauses itself and tells you, instead of retrying forever.">
            <c:ToggleSwitch IsChecked="{Binding Settings.Advanced.AutoRestartAfterCrash}" />
        </c:SettingCard>
        <c:SettingCard Header="Run with administrator rights" Icon="&#xEA18;"
                       Description="Needed to switch while an app running as administrator is in front. Uses a scheduled task at sign-in instead of the normal startup entry.">
            <c:ToggleSwitch x:Name="ElevatedToggle" IsChecked="{Binding Settings.Advanced.RunElevated, Mode=OneWay}" Click="OnElevatedClick" />
        </c:SettingCard>

        <TextBlock Style="{StaticResource SectionHeaderText}" Text="Apps" />
        <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,4" CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyText}" Text="Always use Windows Alt + Tab in" />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,10" Text="One program per line, for example game.exe" />
                    <TextBox Height="120" AcceptsReturn="True" TextWrapping="NoWrap" VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas"
                             Text="{Binding Settings.Advanced.PassthroughProcesses, Converter={StaticResource Lines}, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource BodyText}" Text="Never show windows of" />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,10" Text="One program per line, for example helper.exe" />
                    <TextBox Height="120" AcceptsReturn="True" TextWrapping="NoWrap" VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas"
                             Text="{Binding Settings.Advanced.HiddenProcesses, Converter={StaticResource Lines}, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Style="{StaticResource SectionHeaderText}" Text="Diagnostics" />
        <c:SettingCard Header="Log detail" Icon="&#xE9D9;" Description="Logs stay on this PC and are trimmed automatically.">
            <ComboBox ItemsSource="{x:Static s:Options.LogLevels}" SelectedValuePath="Value" SelectedValue="{Binding Settings.Advanced.LogLevel}" />
        </c:SettingCard>
        <c:SettingCard Header="Files" Icon="&#xE8B7;">
            <StackPanel Orientation="Horizontal">
                <Button Content="Open logs folder" Click="OnOpenLogs" Margin="0,0,8,0" />
                <Button Content="Open settings folder" Click="OnOpenSettingsFolder" />
            </StackPanel>
        </c:SettingCard>
        <c:SettingCard Header="Restart FlowSwitch" Icon="&#xE72C;" Description="Starts the switcher again, for example after changing drivers.">
            <Button Content="Restart" Click="OnRestart" />
        </c:SettingCard>
        <c:SettingCard Header="Reset all settings" Icon="&#xE7BA;" Description="Restores every option on every page to its default.">
            <Button Style="{StaticResource DangerButton}" Content="Reset" Click="OnReset" />
        </c:SettingCard>
    </StackPanel>
</UserControl>
