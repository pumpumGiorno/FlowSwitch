<Window x:Class="FlowSwitch.Settings.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlowSwitch Settings"
        Width="1100" Height="760" MinWidth="880" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource FallbackBackdropBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource TextFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        Icon="pack://application:,,,/Assets/flowswitch-256.png">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="272" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Tint over Mica so the window sits in the same deep night-blue world as the overlay. -->
        <Border x:Name="ContentTint" Grid.ColumnSpan="2" Background="#B80A0D14" />
        <Border x:Name="SidebarTint" Background="#660C1019" BorderBrush="#12FFFFFF" BorderThickness="0,0,1,0" />

        <!-- ───────────── Sidebar ───────────── -->
        <Grid Margin="14,0,14,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="8,16,0,22">
                <Image Source="pack://application:,,,/Assets/flowswitch-mark.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="FlowSwitch" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource CaptionText}" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,1,0,0" />
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="1">
                <StackPanel x:Name="NavPanel">
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE713;" Content="General" x:Name="NavGeneral" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE790;" Content="Appearance" x:Name="NavAppearance" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE706;" Content="Solar System" x:Name="NavSolar" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE768;" Content="Animations" x:Name="NavAnimations" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xEC4A;" Content="Performance" x:Name="NavPerformance" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE765;" Content="Hotkeys" x:Name="NavHotkeys" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE90F;" Content="Advanced" x:Name="NavAdvanced" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE946;" Content="About" x:Name="NavAbout" />
                </StackPanel>
                <!-- The selection pill glides between entries. -->
                <Canvas IsHitTestVisible="False">
                    <Border x:Name="NavIndicator" Width="3" Height="18" CornerRadius="1.5" Canvas.Left="0" Canvas.Top="0"
                            Background="{StaticResource AccentGradientBrush}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="NavIndicatorScale" ScaleY="1" />
                                <TranslateTransform x:Name="NavIndicatorOffset" />
                            </TransformGroup>
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.8" Color="{StaticResource AccentColor}" />
                        </Border.Effect>
                    </Border>
                </Canvas>
            </Grid>

            <!-- Status + try it -->
            <Border Grid.Row="2" Style="{StaticResource GlassPanel}" Padding="14,12" CornerRadius="12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#FF3DDC97" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Text="Running" Margin="8,0,0,1" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="StatusDetail" Style="{StaticResource CaptionText}" Margin="16,2,0,10" Text="Alt + Tab is handled by FlowSwitch." />
                    <Button x:Name="TryButton" Style="{StaticResource AccentButton}" HorizontalAlignment="Stretch" Click="OnTryClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,1,8,0" />
                            <TextBlock x:Name="TryText" Text="Try it" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ───────────── Content ───────────── -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" WindowChrome.IsHitTestVisibleInChrome="True" Click="OnMinimize" ToolTip="Minimize" />
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" WindowChrome.IsHitTestVisibleInChrome="True" Click="OnMaximize" />
                <Button x:Name="CloseButton" Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;" WindowChrome.IsHitTestVisibleInChrome="True" Click="OnClose" ToolTip="Close" />
            </StackPanel>

            <ScrollViewer x:Name="PageScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ContentControl x:Name="PageHost" Margin="44,0,40,44" MaxWidth="900" HorizontalAlignment="Stretch" Focusable="False" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
