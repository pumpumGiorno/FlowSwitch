<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ── Palette: the same deep graphite / night-blue world as the overlay ── -->
    <Color x:Key="BaseColor">#FF0A0D14</Color>
    <Color x:Key="BaseTranslucentColor">#D90A0D14</Color>
    <Color x:Key="SidebarColor">#8C0C1019</Color>
    <Color x:Key="SurfaceColor">#FF131826</Color>
    <Color x:Key="SurfaceHoverColor">#FF182032</Color>
    <Color x:Key="SurfaceRaisedColor">#FF1B2233</Color>
    <Color x:Key="StrokeColor">#1CFFFFFF</Color>
    <Color x:Key="StrokeStrongColor">#33FFFFFF</Color>
    <Color x:Key="TextPrimaryColor">#FFF2F4F8</Color>
    <Color x:Key="TextSecondaryColor">#FFA6AFC2</Color>
    <Color x:Key="TextTertiaryColor">#FF6F788C</Color>
    <Color x:Key="AccentColor">#FF7A84FF</Color>
    <Color x:Key="AccentAltColor">#FF56D6FF</Color>
    <Color x:Key="AccentSoftColor">#337A84FF</Color>
    <Color x:Key="DangerColor">#FFFF6B7A</Color>

    <SolidColorBrush x:Key="BaseBrush" Color="{StaticResource BaseColor}" />
    <SolidColorBrush x:Key="BaseTranslucentBrush" Color="{StaticResource BaseTranslucentColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="StrokeBrush" Color="{StaticResource StrokeColor}" />
    <SolidColorBrush x:Key="StrokeStrongBrush" Color="{StaticResource StrokeStrongColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{StaticResource AccentColor}" />
        <GradientStop Offset="1" Color="{StaticResource AccentAltColor}" />
    </LinearGradientBrush>

    <!-- Glass card: faint top highlight fading into the surface. -->
    <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#E6161C2B" />
        <GradientStop Offset="1" Color="#E6111624" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardStrokeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#2EFFFFFF" />
        <GradientStop Offset="0.35" Color="#14FFFFFF" />
        <GradientStop Offset="1" Color="#0DFFFFFF" />
    </LinearGradientBrush>

    <!-- Window background used when Mica is unavailable (Windows 10). -->
    <RadialGradientBrush x:Key="FallbackBackdropBrush" Center="0.25,0" GradientOrigin="0.25,0" RadiusX="1.2" RadiusY="1.1">
        <GradientStop Offset="0" Color="#FF151B2E" />
        <GradientStop Offset="0.55" Color="#FF0B0F18" />
        <GradientStop Offset="1" Color="#FF080A10" />
    </RadialGradientBrush>

    <!-- ── Typography ── -->
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="SmallFont">Segoe UI Variable Small, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="TitleSize">28</sys:Double>
    <sys:Double x:Key="SubtitleSize">20</sys:Double>
    <sys:Double x:Key="BodySize">14</sys:Double>
    <sys:Double x:Key="CaptionSize">12</sys:Double>

    <CornerRadius x:Key="CardRadius">14</CornerRadius>
    <CornerRadius x:Key="ControlRadius">8</CornerRadius>

    <!-- Motion tokens (mirrors docs/MOTION.md). -->
    <Duration x:Key="MicroDuration">0:0:0.14</Duration>
    <Duration x:Key="NormalDuration">0:0:0.22</Duration>
    <CubicEase x:Key="EnterEase" EasingMode="EaseOut" />
    <QuinticEase x:Key="GlideEase" EasingMode="EaseOut" />

    <DropShadowEffect x:Key="SoftShadow" BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.45" Color="Black" />
    <DropShadowEffect x:Key="AccentGlow" BlurRadius="22" ShadowDepth="0" Opacity="0.65" Color="{StaticResource AccentColor}" />
</ResourceDictionary>
