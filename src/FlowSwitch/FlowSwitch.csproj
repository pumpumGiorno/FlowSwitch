<Project Sdk="Microsoft.NET.Sdk">
  <!-- The resident FlowSwitch process: keyboard hook, window tracking, overlay renderer, tray.
       Deliberately free of WPF/WinForms/WinUI so it starts fast and stays small in memory. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(FlowSwitchWindowsTargetFramework)</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>FlowSwitch</RootNamespace>
    <AssemblyName>FlowSwitch</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\icons\FlowSwitch.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TieredPGO>true</TieredPGO>
    <TieredCompilation>true</TieredCompilation>
    <!-- Readable exception messages in the log (UseSystemResourceKeys would reduce them to resource keys). -->
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1416;SYSLIB1054</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishReadyToRun>true</PublishReadyToRun>
    <SelfContained>false</SelfContained>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlowSwitch.Core\FlowSwitch.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Shaders\FlowSwitch.hlsl" LogicalName="FlowSwitch.Shaders.FlowSwitch.hlsl" />
    <EmbeddedResource Include="..\..\assets\icons\FlowSwitch.ico" LogicalName="FlowSwitch.Assets.FlowSwitch.ico" />
    <EmbeddedResource Include="..\..\assets\icons\FlowSwitch-paused.ico" LogicalName="FlowSwitch.Assets.FlowSwitch-paused.ico" />
  </ItemGroup>
</Project>
