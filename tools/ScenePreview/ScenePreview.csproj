<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the real Core engine (session, animator, layouts, composer) headless and dumps the
       resulting display lists as JSON for tools/web-preview, which renders them with the same
       shaders cross-compiled to WebGL. Used to review motion and visuals on any OS. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\FlowSwitch.Core\FlowSwitch.Core.csproj" />
  </ItemGroup>
</Project>
